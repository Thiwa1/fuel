<Window x:Class="WpfApp1.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:views="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="Pay Bill System - Pro" Height="650" Width="1000" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryGreen}">
            <StackPanel>
                <!-- Logo Area -->
                <StackPanel Orientation="Horizontal" Margin="20,20,20,40">
                    <Ellipse Width="40" Height="40" Fill="White" Margin="0,0,10,0"/>
                    <TextBlock Text="Pay Bill" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menu Items -->
                <Button x:Name="btnDashboard" Content="Dashboard" Style="{StaticResource MenuButton}" Click="BtnDashboard_Click"/>
                <Button x:Name="btnEmployees" Content="Employees" Style="{StaticResource MenuButton}" Click="BtnEmployees_Click"/>
                <Button x:Name="btnPayments" Content="Payments (Excel)" Style="{StaticResource MenuButton}" Click="BtnPayments_Click"/>
                <Button x:Name="btnSchedules" Content="Schedules" Style="{StaticResource MenuButton}" Click="BtnSchedules_Click"/>
                <Button x:Name="btnLogout" Content="Logout" Style="{StaticResource MenuButton}" VerticalAlignment="Bottom" Margin="0,50,0,0" Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="White" CornerRadius="10,0,0,10" Margin="0,0,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtPageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                <ContentControl x:Name="contentArea" Grid.Row="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
