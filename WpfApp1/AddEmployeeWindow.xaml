<Window x:Class="WpfApp1.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Add Employee" Height="450" Width="400" Icon="/bpo.jpg">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Calling Name:" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCallingName" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Account Name:" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAccountName" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Employee Number:" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtEmployeeNumber" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bank:" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtBank" Margin="5" TextChanged="Validation_TextChanged"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Branch:" Margin="5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtBranch" Margin="5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="NIC No:" Margin="5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtNicNo" Margin="5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Account Number:" Margin="5"/>
        <StackPanel Grid.Row="6" Grid.Column="1">
            <TextBox x:Name="txtAccountNumber" Margin="5" TextChanged="Validation_TextChanged"/>
            <TextBlock x:Name="txtValidationMessage" FontSize="11" Foreground="Red" Margin="5,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Area:" Margin="5"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtArea" Margin="5"/>

        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Save" Width="80" Margin="5" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="5" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
