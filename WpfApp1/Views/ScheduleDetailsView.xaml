<UserControl x:Class="WpfApp1.Views.ScheduleDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnBack" Content="&lt; Back" Width="60" Margin="0,0,20,0" Click="btnBack_Click"/>

            <TextBlock Text="Search Employee:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox x:Name="txtSearch" Width="150" Margin="0,0,20,0" TextChanged="txtSearch_TextChanged"/>

            <Button x:Name="btnAddPayment" Content="Add Payment" Margin="0,0,10,0" Padding="10,5" Click="btnAddPayment_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnExport" Content="Export to Excel" Margin="0,0,10,0" Padding="10,5" Click="btnExport_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnDelete" Content="Delete Selected" Margin="0,0,10,0" Padding="10,5" Click="btnDelete_Click" Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="dgPayments" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Calling Name" Binding="{Binding Employee.CallingName}" Width="150"/>
                <DataGridTextColumn Header="Emp #" Binding="{Binding Employee.EmployeeNumber}" Width="80"/>
                <DataGridTextColumn Header="Account Name" Binding="{Binding Employee.AccountName}" Width="150"/>
                <DataGridTextColumn Header="Bank" Binding="{Binding Employee.Bank}" Width="100"/>
                <DataGridTextColumn Header="Branch" Binding="{Binding Employee.Branch}" Width="80"/>
                <DataGridTextColumn Header="Account No" Binding="{Binding Employee.AccountNumber}" Width="120"/>
                <DataGridTextColumn Header="Area" Binding="{Binding Employee.Area}" Width="100"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
